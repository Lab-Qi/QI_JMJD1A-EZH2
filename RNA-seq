#VOLCANO PLOT#
DE <-read.csv("~/RNA_Seq/EZH2/EZH2_DE.csv")
colnames (DE)
dim (DE)
DE$exp <- "NS"
DE$exp[DE$log2FoldChange > 0.25 & DE$padj < 0.05] <- "UPREGULATED"
DE$exp[DE$log2FoldChange < -0.25 & DE$padj < 0.05] <- "DOWNREGULATED"
UP <- subset(DE, exp == "UPREGULATED")
nonsig <- subset(DE, exp == "NS")
DOWN <- subset(DE, exp == "DOWNREGULATED")
write.csv(UP, file = "~/RNA_Seq/EZH2/EZH2_upregulated_f0.25_p0.05.csv")
write.csv(DOWN, file = "~/RNA_Seq/EZH2/EZH2_downregulated_f_0.25_p0.05.csv")
write.csv(nonsig, file = "~/RNA_Seq/EZH2/EZH2_nonsignificant_f0.25_p0.05.csv")
cntfrq <- count(DE, exp)
ggplot(cntfrq, aes(x = exp, y = n, fill = exp)) +
  geom_col(width = 0.5) +
  geom_text(aes(label = n), vjust = 0, size = 2.5) +
  scale_y_break(c(1500, 63000)) +
  scale_fill_manual(values = c("DOWNREGULATED" = "lightblue", "NS" = "grey", "UPREGULATED" = "red"), guide = "none") +
  labs(title = "Gene Expression Profile of EZH2_f0.25_p0.05 KD",
     x = "Frequency",
     y = "Gene expression") +
  theme(panel.background = element_rect(fill = "white"),
        axis.line = element_line(color="black", size = 0.5),
        panel.grid.minor = element_blank(),
        panel.grid.major = element_blank())


colr <- c("UPREGULATED" = "red", "DOWNREGULATED" = "lightblue", "NS" = "grey")
ggplot(data=DE,aes(x = log2FoldChange, y = -log10(padj), col = exp)) +
  geom_point(size = 1) +
  theme_minimal() +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed") + 
  geom_vline(xintercept = c(-0.25, 0.25), linetype = "dashed") +
  scale_colour_manual(values = colr) +
  scale_x_continuous(breaks = c(seq(-10, 10, 2)), limits = c(-10, 10)) +
  scale_y_continuous(breaks = c(seq(0, 50, 3)), limits = c(0, 50)) +
  labs(title = "Gene Expression Profile of EZH2__f0.25_p0.05 KD",
       x = "log2(fold change)",
       y = "-log10(adjusted P-value)",
       colour = "Expression") +
  theme_bw() +
  theme(panel.border = element_rect(colour = "black", fill = NA, size= 0.5),    
        panel.grid.minor = element_blank(),
        panel.grid.major = element_blank(),
        legend.key.size = unit(0.25, 'cm'),
        legend.title = element_text(size=10),
        legend.text = element_text(size=7))


