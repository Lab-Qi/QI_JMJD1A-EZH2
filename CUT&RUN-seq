#ChIPpeakanno
library(ChIPpeakAnno)
library(GenomicRanges)
library(GenomeInfoDb)
data1 <- read.table("../../sk/C42/EZH2-shcon.rmbl.bed",sep="\t")
data1 <- data1[,1:5]
colnames(data1) <- c("chr", "start", "end", "x1", "score")
gr1 <- toGRanges(data1, format="BED", header=FALSE, skip=3)
data2 <- read.table("../../sk/C42/JMJD1A-shcon.rmbl.bed",sep="\t")
data2 <- data2[,1:5]
colnames(data2) <- c("chr", "start", "end", "x1", "score")
gr2 <- toGRanges(data2, format="BED", header=FALSE, skip=3)
ol <- findOverlapsOfPeaks(gr1,gr2, connectedPeaks="keepAll")
ol <- addMetadata(ol, colNames="score", FUN=mean)
makeVennDiagram(ol, fill=c("#66ccff", "#66cc00"), # circle fill color
                col=c("#66ccff", "#66cc00"), #circle border color
                cat.col=c("#66ccff", "#66cc00")) # label color, keep same as circle border color
write.table(ol$peaklist$gr1, file="../../new_analysis/JMJD1A_enriched.txt", sep="\t", quote=F, row.names=F, col.names=F)
write.table(ol$peaklist$`gr1///gr2`, file="../../new_analysis/common.txt", sep="\t", quote=F, row.names=F, col.names=F)
write.table(ol$peaklist$gr2, file="../../new_analysis/EZH2_enriched.txt", sep="\t", quote=F, row.names=F, col.names=F)

